{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "PlayNirvanaConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;MultipleActiveResultSets=True;Initial Catalog=PlayNirvana;Application Name=PlayNirvana"
    },
    "RoundOptions": {
        "MinimunActiveRounds": 5,
        "RoundsGeneratorIntervalInMinutes": 2,
        "RoundDurationInSeconds": 30,

        "RoundLockBeforeRaceStart": 5,
        "RaceDurationInSeconds": 10,
        "MinimumRoundDurationBeforeLockInSeconds": 10
    },
    "TicketOptions": {
        "MaxBetAmount": 20,
        "MaxWinAmount": 1000
    }
}
