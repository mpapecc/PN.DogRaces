{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "PlayNirvanaConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;MultipleActiveResultSets=True;Initial Catalog=PlayNirvana;Application Name=PlayNirvana"
    },
    "RoundOptions": {
        "MinimunActiveRounds": 5,
        "NewRoundGenerationThreshold": 30,
        "RoundDurationInSeconds": 120
    }
}
